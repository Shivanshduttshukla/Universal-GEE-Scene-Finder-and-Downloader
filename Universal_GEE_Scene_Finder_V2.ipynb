    {
      "cell_type": "code",
      "source": [
        "#@markdown ### 🛰️ AOI Scene Downloader\n",
        "#@markdown\n",
        "#@markdown **What you need to provide:**\n",
        "#@markdown\n",
        "#@markdown 1. **AOI file** — Upload your area of interest as a Shapefile (`.zip`), GeoPackage (`.gpkg`), GeoJSON (`.geojson`), KML (`.kml`), or supported vector format.\n",
        "#@markdown 2. **Scene** — Select the satellite scene you want to download from the available scenes.\n",
        "#@markdown 3. **Bands** — Choose **all available bands** or select specific bands for download.\n",
        "#@markdown\n",
        "#@markdown **What this code does:**\n",
        "#@markdown\n",
        "#@markdown - Checks whether the selected scene **completely covers your AOI** and gives a warning if only part of the AOI is captured.\n",
        "#@markdown - Allows downloading even when the scene covers only part of the AOI; only the **scene–AOI overlap** is retained.\n",
        "#@markdown - Clips the downloaded raster to the **actual AOI polygon**, not just its rectangular bounding box.\n",
        "#@markdown - Crops the output to the AOI extent and masks pixels outside the AOI.\n",
        "#@markdown - Converts all selected output bands to **Float32** for compatible GeoTIFF export.\n",
        "#@markdown - Provides a direct browser download and uses **Google Drive export as a fallback** if the direct download fails.\n",
        "#@markdown\n",
        "#@markdown **⚠️ Important:** If the selected scene does not completely cover the AOI, the output will contain valid data only for the portion of the AOI covered by that scene..\n",
        "# ==============================================================================\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# SETTINGS\n",
        "# ==============================================================================\n",
        "\n",
        "CLIP_TO_SHAPEFILE = True\n",
        "REQUIRE_POINT_INSIDE_AOI = True\n",
        "\n",
        "EXPORT_SCALE_METERS = 10\n",
        "\n",
        "OUTPUT_FILENAME = \"AOI_Scene\"\n",
        "OUTPUT_DIRECTORY = \"/content/satellite_downloads\"\n",
        "AUTO_DOWNLOAD = True\n",
        "\n",
        "ENABLE_DRIVE_FALLBACK = True\n",
        "DRIVE_EXPORT_FOLDER = \"GEE_Downloads\"\n",
        "\n",
        "# AOI coverage threshold.\n",
        "# 99.99% is treated as complete coverage to avoid tiny\n",
        "# floating-point/geometric differences.\n",
        "AOI_COMPLETE_COVERAGE_THRESHOLD = 99.99\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# IMPORTS\n",
        "# ==============================================================================\n",
        "\n",
        "import os\n",
        "import math\n",
        "import zipfile\n",
        "import requests\n",
        "\n",
        "import pandas as pd\n",
        "import geopandas as gpd\n",
        "import ee\n",
        "import ipywidgets as widgets\n",
        "\n",
        "from IPython.display import display, clear_output\n",
        "\n",
        "from shapely.geometry import (\n",
        "    Polygon,\n",
        "    MultiPolygon,\n",
        "    GeometryCollection\n",
        ")\n",
        "\n",
        "try:\n",
        "    from shapely.validation import make_valid as shapely_make_valid\n",
        "except Exception:\n",
        "    shapely_make_valid = None\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# DIRECTORIES\n",
        "# ==============================================================================\n",
        "\n",
        "os.makedirs(\n",
        "    OUTPUT_DIRECTORY,\n",
        "    exist_ok=True\n",
        ")\n",
        "\n",
        "WORKDIR = \"/content/uploaded_aoi\"\n",
        "\n",
        "os.makedirs(\n",
        "    WORKDIR,\n",
        "    exist_ok=True\n",
        ")\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# CHECK DATAFRAME\n",
        "# ==============================================================================\n",
        "\n",
        "if \"df\" not in globals():\n",
        "\n",
        "    raise RuntimeError(\n",
        "        \"❌ 'df' was not found. Run the satellite query cell first.\"\n",
        "    )\n",
        "\n",
        "\n",
        "if df is None or len(df) == 0:\n",
        "\n",
        "    raise RuntimeError(\n",
        "        \"❌ The dataframe 'df' is empty.\"\n",
        "    )\n",
        "\n",
        "\n",
        "if \"GEE_Asset_ID\" not in df.columns:\n",
        "\n",
        "    raise RuntimeError(\n",
        "        \"❌ 'GEE_Asset_ID' column is missing from df.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# BASIC HELPERS\n",
        "# ==============================================================================\n",
        "\n",
        "def get_scene_label(row, index):\n",
        "\n",
        "    scene_id = str(\n",
        "        row[\"GEE_Asset_ID\"]\n",
        "    )\n",
        "\n",
        "    date_text = \"\"\n",
        "\n",
        "    for col in [\n",
        "        \"Acquisition_Date\",\n",
        "        \"Date\",\n",
        "        \"DATE\",\n",
        "        \"system:time_start\"\n",
        "    ]:\n",
        "\n",
        "        if col in row.index:\n",
        "\n",
        "            try:\n",
        "\n",
        "                value = row[col]\n",
        "\n",
        "                if pd.notna(value):\n",
        "\n",
        "                    date_text = str(value)\n",
        "\n",
        "                    break\n",
        "\n",
        "            except Exception:\n",
        "\n",
        "                pass\n",
        "\n",
        "    if date_text:\n",
        "\n",
        "        return (\n",
        "            f\"{index} | \"\n",
        "            f\"{date_text} | \"\n",
        "            f\"{scene_id}\"\n",
        "        )\n",
        "\n",
        "    return (\n",
        "        f\"{index} | {scene_id}\"\n",
        "    )\n",
        "\n",
        "\n",
        "def get_query_coordinates(row):\n",
        "\n",
        "    lat_candidates = [\n",
        "        \"Query_Latitude\",\n",
        "        \"Latitude\",\n",
        "        \"LATITUDE\",\n",
        "        \"lat\",\n",
        "        \"Lat\"\n",
        "    ]\n",
        "\n",
        "    lon_candidates = [\n",
        "        \"Query_Longitude\",\n",
        "        \"Longitude\",\n",
        "        \"LONGITUDE\",\n",
        "        \"lon\",\n",
        "        \"Lon\"\n",
        "    ]\n",
        "\n",
        "    lat = None\n",
        "    lon = None\n",
        "\n",
        "    for c in lat_candidates:\n",
        "\n",
        "        if c in row.index:\n",
        "\n",
        "            try:\n",
        "\n",
        "                if pd.notna(row[c]):\n",
        "\n",
        "                    lat = float(row[c])\n",
        "                    break\n",
        "\n",
        "            except Exception:\n",
        "\n",
        "                pass\n",
        "\n",
        "    for c in lon_candidates:\n",
        "\n",
        "        if c in row.index:\n",
        "\n",
        "            try:\n",
        "\n",
        "                if pd.notna(row[c]):\n",
        "\n",
        "                    lon = float(row[c])\n",
        "                    break\n",
        "\n",
        "            except Exception:\n",
        "\n",
        "                pass\n",
        "\n",
        "    return lat, lon\n",
        "\n",
        "\n",
        "def get_available_bands(asset_id):\n",
        "\n",
        "    img = ee.Image(asset_id)\n",
        "\n",
        "    bands = (\n",
        "        img.bandNames()\n",
        "        .getInfo()\n",
        "    )\n",
        "\n",
        "    return img, bands\n",
        "\n",
        "\n",
        "def safe_filename(name):\n",
        "\n",
        "    cleaned = \"\".join(\n",
        "        c\n",
        "        for c in str(name)\n",
        "        if c.isalnum()\n",
        "        or c in (\"-\", \"_\")\n",
        "    ).rstrip()\n",
        "\n",
        "    return cleaned or \"AOI_Scene\"\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# FILE HELPERS\n",
        "# ==============================================================================\n",
        "\n",
        "def find_files(root, extensions):\n",
        "\n",
        "    results = []\n",
        "\n",
        "    for current_root, dirs, files_list in os.walk(root):\n",
        "\n",
        "        for fname in files_list:\n",
        "\n",
        "            if fname.lower().endswith(extensions):\n",
        "\n",
        "                results.append(\n",
        "                    os.path.join(\n",
        "                        current_root,\n",
        "                        fname\n",
        "                    )\n",
        "                )\n",
        "\n",
        "    return results\n",
        "\n",
        "\n",
        "def extract_uploaded_items(value):\n",
        "\n",
        "    items = []\n",
        "\n",
        "    if isinstance(value, dict):\n",
        "\n",
        "        for fname, info in value.items():\n",
        "\n",
        "            items.append(\n",
        "                (\n",
        "                    fname,\n",
        "                    bytes(info[\"content\"])\n",
        "                )\n",
        "            )\n",
        "\n",
        "    else:\n",
        "\n",
        "        for info in value:\n",
        "\n",
        "            if isinstance(info, dict):\n",
        "\n",
        "                fname = info.get(\"name\")\n",
        "                content = info.get(\"content\")\n",
        "\n",
        "            else:\n",
        "\n",
        "                fname = getattr(\n",
        "                    info,\n",
        "                    \"name\",\n",
        "                    None\n",
        "                )\n",
        "\n",
        "                content = getattr(\n",
        "                    info,\n",
        "                    \"content\",\n",
        "                    None\n",
        "                )\n",
        "\n",
        "            items.append(\n",
        "                (\n",
        "                    fname,\n",
        "                    bytes(content)\n",
        "                )\n",
        "            )\n",
        "\n",
        "    return items\n",
        "\n",
        "\n",
        "def resolve_main_vector_path(paths):\n",
        "\n",
        "    priority = (\n",
        "        \".zip\",\n",
        "        \".kmz\",\n",
        "        \".gpkg\",\n",
        "        \".geojson\",\n",
        "        \".json\",\n",
        "        \".kml\",\n",
        "        \".shp\"\n",
        "    )\n",
        "\n",
        "    for ext in priority:\n",
        "\n",
        "        for path in paths:\n",
        "\n",
        "            if path.lower().endswith(ext):\n",
        "\n",
        "                return path\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def extract_archive_and_find_vector(path):\n",
        "\n",
        "    base = os.path.splitext(\n",
        "        os.path.basename(path)\n",
        "    )[0]\n",
        "\n",
        "    extract_dir = os.path.join(\n",
        "        WORKDIR,\n",
        "        \"extracted_\" + base\n",
        "    )\n",
        "\n",
        "    os.makedirs(\n",
        "        extract_dir,\n",
        "        exist_ok=True\n",
        "    )\n",
        "\n",
        "    with zipfile.ZipFile(\n",
        "        path,\n",
        "        \"r\"\n",
        "    ) as z:\n",
        "\n",
        "        z.extractall(\n",
        "            extract_dir\n",
        "        )\n",
        "\n",
        "    shp = find_files(\n",
        "        extract_dir,\n",
        "        (\".shp\",)\n",
        "    )\n",
        "\n",
        "    gpkg = find_files(\n",
        "        extract_dir,\n",
        "        (\".gpkg\",)\n",
        "    )\n",
        "\n",
        "    geojson = find_files(\n",
        "        extract_dir,\n",
        "        (\".geojson\", \".json\")\n",
        "    )\n",
        "\n",
        "    kml = find_files(\n",
        "        extract_dir,\n",
        "        (\".kml\",)\n",
        "    )\n",
        "\n",
        "    if shp:\n",
        "        return shp[0], \"shp\"\n",
        "\n",
        "    if gpkg:\n",
        "        return gpkg[0], \"gpkg\"\n",
        "\n",
        "    if geojson:\n",
        "        return geojson[0], \"geojson\"\n",
        "\n",
        "    if kml:\n",
        "        return kml[0], \"kml\"\n",
        "\n",
        "    raise ValueError(\n",
        "        \"❌ No supported vector file was found inside the archive.\"\n",
        "    )\n",
        "\n",
        "\n",
        "def read_kml(path):\n",
        "\n",
        "    try:\n",
        "\n",
        "        return gpd.read_file(\n",
        "            path,\n",
        "            driver=\"KML\"\n",
        "        )\n",
        "\n",
        "    except Exception:\n",
        "\n",
        "        try:\n",
        "\n",
        "            import fiona\n",
        "\n",
        "            fiona.drvsupport.supported_drivers[\n",
        "                \"KML\"\n",
        "            ] = \"rw\"\n",
        "\n",
        "            fiona.drvsupport.supported_drivers[\n",
        "                \"LIBKML\"\n",
        "            ] = \"rw\"\n",
        "\n",
        "        except Exception:\n",
        "\n",
        "            pass\n",
        "\n",
        "        return gpd.read_file(\n",
        "            path,\n",
        "            driver=\"KML\"\n",
        "        )\n",
        "\n",
        "\n",
        "def list_layers(path):\n",
        "\n",
        "    try:\n",
        "\n",
        "        return gpd.list_layers(\n",
        "            path\n",
        "        )[\"name\"].tolist()\n",
        "\n",
        "    except Exception:\n",
        "\n",
        "        try:\n",
        "\n",
        "            import fiona\n",
        "\n",
        "            return fiona.listlayers(\n",
        "                path\n",
        "            )\n",
        "\n",
        "        except Exception:\n",
        "\n",
        "            return []\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# GEOMETRY HELPERS\n",
        "# ==============================================================================\n",
        "\n",
        "def is_finite_number(x):\n",
        "\n",
        "    try:\n",
        "\n",
        "        return math.isfinite(\n",
        "            float(x)\n",
        "        )\n",
        "\n",
        "    except Exception:\n",
        "\n",
        "        return False\n",
        "\n",
        "\n",
        "def clean_coordinate(coord):\n",
        "\n",
        "    if coord is None or len(coord) < 2:\n",
        "\n",
        "        return None\n",
        "\n",
        "    lon = float(coord[0])\n",
        "    lat = float(coord[1])\n",
        "\n",
        "    if not is_finite_number(lon):\n",
        "\n",
        "        return None\n",
        "\n",
        "    if not is_finite_number(lat):\n",
        "\n",
        "        return None\n",
        "\n",
        "    if lat < -90 or lat > 90:\n",
        "\n",
        "        return None\n",
        "\n",
        "    lon = (\n",
        "        (lon + 180.0) % 360.0\n",
        "    ) - 180.0\n",
        "\n",
        "    return [\n",
        "        lon,\n",
        "        lat\n",
        "    ]\n",
        "\n",
        "\n",
        "def clean_ring(coords):\n",
        "\n",
        "    cleaned = []\n",
        "\n",
        "    for coord in coords:\n",
        "\n",
        "        c = clean_coordinate(\n",
        "            coord\n",
        "        )\n",
        "\n",
        "        if c is not None:\n",
        "\n",
        "            cleaned.append(c)\n",
        "\n",
        "    if len(cleaned) < 3:\n",
        "\n",
        "        return None\n",
        "\n",
        "    deduped = []\n",
        "\n",
        "    for c in cleaned:\n",
        "\n",
        "        if (\n",
        "            not deduped\n",
        "            or c != deduped[-1]\n",
        "        ):\n",
        "\n",
        "            deduped.append(c)\n",
        "\n",
        "    cleaned = deduped\n",
        "\n",
        "    if len(cleaned) < 3:\n",
        "\n",
        "        return None\n",
        "\n",
        "    if cleaned[0] != cleaned[-1]:\n",
        "\n",
        "        cleaned.append(\n",
        "            cleaned[0]\n",
        "        )\n",
        "\n",
        "    if len(cleaned) < 4:\n",
        "\n",
        "        return None\n",
        "\n",
        "    return cleaned\n",
        "\n",
        "\n",
        "def polygon_to_ee_coordinates(poly):\n",
        "\n",
        "    if (\n",
        "        poly is None\n",
        "        or poly.is_empty\n",
        "    ):\n",
        "\n",
        "        return None\n",
        "\n",
        "    exterior = clean_ring(\n",
        "        list(\n",
        "            poly.exterior.coords\n",
        "        )\n",
        "    )\n",
        "\n",
        "    if exterior is None:\n",
        "\n",
        "        return None\n",
        "\n",
        "    rings = [\n",
        "        exterior\n",
        "    ]\n",
        "\n",
        "    for interior in poly.interiors:\n",
        "\n",
        "        ring = clean_ring(\n",
        "            list(\n",
        "                interior.coords\n",
        "            )\n",
        "        )\n",
        "\n",
        "        if ring is not None:\n",
        "\n",
        "            rings.append(\n",
        "                ring\n",
        "            )\n",
        "\n",
        "    return rings\n",
        "\n",
        "\n",
        "def geometry_to_polygon_coordinates(geom):\n",
        "\n",
        "    if (\n",
        "        geom is None\n",
        "        or geom.is_empty\n",
        "    ):\n",
        "\n",
        "        return []\n",
        "\n",
        "    if isinstance(\n",
        "        geom,\n",
        "        Polygon\n",
        "    ):\n",
        "\n",
        "        coords = polygon_to_ee_coordinates(\n",
        "            geom\n",
        "        )\n",
        "\n",
        "        return (\n",
        "            [coords]\n",
        "            if coords\n",
        "            else []\n",
        "        )\n",
        "\n",
        "    if isinstance(\n",
        "        geom,\n",
        "        MultiPolygon\n",
        "    ):\n",
        "\n",
        "        result = []\n",
        "\n",
        "        for poly in geom.geoms:\n",
        "\n",
        "            coords = polygon_to_ee_coordinates(\n",
        "                poly\n",
        "            )\n",
        "\n",
        "            if coords:\n",
        "\n",
        "                result.append(\n",
        "                    coords\n",
        "                )\n",
        "\n",
        "        return result\n",
        "\n",
        "    if isinstance(\n",
        "        geom,\n",
        "        GeometryCollection\n",
        "    ):\n",
        "\n",
        "        result = []\n",
        "\n",
        "        for part in geom.geoms:\n",
        "\n",
        "            result.extend(\n",
        "                geometry_to_polygon_coordinates(\n",
        "                    part\n",
        "                )\n",
        "            )\n",
        "\n",
        "        return result\n",
        "\n",
        "    return []\n",
        "\n",
        "\n",
        "def make_ee_aoi_from_shapely(geom):\n",
        "\n",
        "    try:\n",
        "\n",
        "        if not geom.is_valid:\n",
        "\n",
        "            if shapely_make_valid is not None:\n",
        "\n",
        "                geom = shapely_make_valid(\n",
        "                    geom\n",
        "                )\n",
        "\n",
        "            else:\n",
        "\n",
        "                geom = geom.buffer(\n",
        "                    0\n",
        "                )\n",
        "\n",
        "    except Exception:\n",
        "\n",
        "        pass\n",
        "\n",
        "    polygons = (\n",
        "        geometry_to_polygon_coordinates(\n",
        "            geom\n",
        "        )\n",
        "    )\n",
        "\n",
        "    if not polygons:\n",
        "\n",
        "        raise ValueError(\n",
        "            \"AOI contains no usable polygons.\"\n",
        "        )\n",
        "\n",
        "    valid_polygons = []\n",
        "\n",
        "    for polygon in polygons:\n",
        "\n",
        "        valid_rings = []\n",
        "\n",
        "        for ring in polygon:\n",
        "\n",
        "            if (\n",
        "                ring is None\n",
        "                or len(ring) < 4\n",
        "            ):\n",
        "\n",
        "                continue\n",
        "\n",
        "            valid = True\n",
        "\n",
        "            for coord in ring:\n",
        "\n",
        "                if (\n",
        "                    len(coord) != 2\n",
        "                    or not is_finite_number(coord[0])\n",
        "                    or not is_finite_number(coord[1])\n",
        "                ):\n",
        "\n",
        "                    valid = False\n",
        "\n",
        "                    break\n",
        "\n",
        "            if valid:\n",
        "\n",
        "                valid_rings.append(\n",
        "                    ring\n",
        "                )\n",
        "\n",
        "        if valid_rings:\n",
        "\n",
        "            valid_polygons.append(\n",
        "                valid_rings\n",
        "            )\n",
        "\n",
        "    if not valid_polygons:\n",
        "\n",
        "        raise ValueError(\n",
        "            \"No valid polygon coordinates remained.\"\n",
        "        )\n",
        "\n",
        "    if len(valid_polygons) == 1:\n",
        "\n",
        "        return ee.Geometry.Polygon(\n",
        "            valid_polygons[0],\n",
        "            proj=\"EPSG:4326\",\n",
        "            geodesic=False\n",
        "        )\n",
        "\n",
        "    return ee.Geometry.MultiPolygon(\n",
        "        valid_polygons,\n",
        "        proj=\"EPSG:4326\",\n",
        "        geodesic=False\n",
        "    )\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# AOI LOADER\n",
        "# ==============================================================================\n",
        "\n",
        "def load_vector_aoi(\n",
        "    path,\n",
        "    kind,\n",
        "    layer_name=None\n",
        "):\n",
        "\n",
        "    if kind == \"shp\":\n",
        "\n",
        "        gdf = gpd.read_file(\n",
        "            path\n",
        "        )\n",
        "\n",
        "    elif kind == \"gpkg\":\n",
        "\n",
        "        if layer_name:\n",
        "\n",
        "            gdf = gpd.read_file(\n",
        "                path,\n",
        "                layer=layer_name\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            gdf = gpd.read_file(\n",
        "                path\n",
        "            )\n",
        "\n",
        "    elif kind == \"geojson\":\n",
        "\n",
        "        gdf = gpd.read_file(\n",
        "            path\n",
        "        )\n",
        "\n",
        "    elif kind == \"kml\":\n",
        "\n",
        "        gdf = read_kml(\n",
        "            path\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        raise ValueError(\n",
        "            f\"Unsupported AOI format: {kind}\"\n",
        "        )\n",
        "\n",
        "    if gdf.empty:\n",
        "\n",
        "        raise ValueError(\n",
        "            \"❌ Uploaded AOI contains no features.\"\n",
        "        )\n",
        "\n",
        "    if gdf.crs is None:\n",
        "\n",
        "        print(\n",
        "            \"⚠️ AOI has no CRS information.\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"   Assuming EPSG:4326.\"\n",
        "        )\n",
        "\n",
        "        gdf = gdf.set_crs(\n",
        "            \"EPSG:4326\",\n",
        "            allow_override=True\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\n",
        "            f\"   Original CRS: {gdf.crs}\"\n",
        "        )\n",
        "\n",
        "        gdf = gdf.to_crs(\n",
        "            \"EPSG:4326\"\n",
        "        )\n",
        "\n",
        "    gdf = gdf[\n",
        "        gdf.geometry.notnull()\n",
        "    ].copy()\n",
        "\n",
        "    gdf = gdf[\n",
        "        ~gdf.geometry.is_empty\n",
        "    ].copy()\n",
        "\n",
        "    repaired = []\n",
        "\n",
        "    for geom in gdf.geometry:\n",
        "\n",
        "        try:\n",
        "\n",
        "            if not geom.is_valid:\n",
        "\n",
        "                if shapely_make_valid:\n",
        "\n",
        "                    geom = shapely_make_valid(\n",
        "                        geom\n",
        "                    )\n",
        "\n",
        "                else:\n",
        "\n",
        "                    geom = geom.buffer(\n",
        "                        0\n",
        "                    )\n",
        "\n",
        "        except Exception:\n",
        "\n",
        "            try:\n",
        "\n",
        "                geom = geom.buffer(\n",
        "                    0\n",
        "                )\n",
        "\n",
        "            except Exception:\n",
        "\n",
        "                continue\n",
        "\n",
        "        if (\n",
        "            geom is None\n",
        "            or geom.is_empty\n",
        "        ):\n",
        "\n",
        "            continue\n",
        "\n",
        "        if isinstance(\n",
        "            geom,\n",
        "            Polygon\n",
        "        ):\n",
        "\n",
        "            repaired.append(\n",
        "                geom\n",
        "            )\n",
        "\n",
        "        elif isinstance(\n",
        "            geom,\n",
        "            MultiPolygon\n",
        "        ):\n",
        "\n",
        "            repaired.extend(\n",
        "                list(\n",
        "                    geom.geoms\n",
        "                )\n",
        "            )\n",
        "\n",
        "        elif isinstance(\n",
        "            geom,\n",
        "            GeometryCollection\n",
        "        ):\n",
        "\n",
        "            for part in geom.geoms:\n",
        "\n",
        "                if isinstance(\n",
        "                    part,\n",
        "                    Polygon\n",
        "                ):\n",
        "\n",
        "                    repaired.append(\n",
        "                        part\n",
        "                    )\n",
        "\n",
        "                elif isinstance(\n",
        "                    part,\n",
        "                    MultiPolygon\n",
        "                ):\n",
        "\n",
        "                    repaired.extend(\n",
        "                        list(\n",
        "                            part.geoms\n",
        "                        )\n",
        "                    )\n",
        "\n",
        "    if not repaired:\n",
        "\n",
        "        raise ValueError(\n",
        "            \"❌ No valid polygon geometry remained.\"\n",
        "        )\n",
        "\n",
        "    gdf = gpd.GeoDataFrame(\n",
        "        geometry=repaired,\n",
        "        crs=\"EPSG:4326\"\n",
        "    )\n",
        "\n",
        "    try:\n",
        "\n",
        "        merged = gdf.geometry.union_all()\n",
        "\n",
        "    except AttributeError:\n",
        "\n",
        "        merged = gdf.geometry.unary_union\n",
        "\n",
        "    if (\n",
        "        merged is None\n",
        "        or merged.is_empty\n",
        "    ):\n",
        "\n",
        "        raise ValueError(\n",
        "            \"❌ Final AOI is empty.\"\n",
        "        )\n",
        "\n",
        "    try:\n",
        "\n",
        "        if not merged.is_valid:\n",
        "\n",
        "            if shapely_make_valid:\n",
        "\n",
        "                merged = shapely_make_valid(\n",
        "                    merged\n",
        "                )\n",
        "\n",
        "            else:\n",
        "\n",
        "                merged = merged.buffer(\n",
        "                    0\n",
        "                )\n",
        "\n",
        "    except Exception:\n",
        "\n",
        "        pass\n",
        "\n",
        "    minx, miny, maxx, maxy = merged.bounds\n",
        "\n",
        "    print()\n",
        "    print(\n",
        "        \"🌍 Final AOI geographic bounds:\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"   Longitude: {minx:.8f} → {maxx:.8f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"   Latitude : {miny:.8f} → {maxy:.8f}\"\n",
        "    )\n",
        "\n",
        "    print()\n",
        "    print(\n",
        "        \"🔄 Converting AOI to Earth Engine...\"\n",
        "    )\n",
        "\n",
        "    try:\n",
        "\n",
        "        ee_aoi = make_ee_aoi_from_shapely(\n",
        "            merged\n",
        "        )\n",
        "\n",
        "        ee_aoi.area(\n",
        "            maxError=1\n",
        "        ).getInfo()\n",
        "\n",
        "    except Exception as e:\n",
        "\n",
        "        raise ValueError(\n",
        "            \"❌ Earth Engine rejected the repaired AOI geometry.\\n\"\n",
        "            f\"Earth Engine error:\\n{e}\"\n",
        "        )\n",
        "\n",
        "    print(\n",
        "        \"✅ Earth Engine geometry validated.\"\n",
        "    )\n",
        "\n",
        "    return gdf, ee_aoi\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# INTERIOR AOI COORDINATE\n",
        "# ==============================================================================\n",
        "\n",
        "def get_suggested_inside_coordinate():\n",
        "\n",
        "    if uploaded_gdf is None:\n",
        "\n",
        "        return None, None\n",
        "\n",
        "    try:\n",
        "\n",
        "        try:\n",
        "\n",
        "            merged = (\n",
        "                uploaded_gdf.geometry.union_all()\n",
        "            )\n",
        "\n",
        "        except AttributeError:\n",
        "\n",
        "            merged = (\n",
        "                uploaded_gdf.geometry.unary_union\n",
        "            )\n",
        "\n",
        "        if (\n",
        "            merged is None\n",
        "            or merged.is_empty\n",
        "        ):\n",
        "\n",
        "            return None, None\n",
        "\n",
        "        point = (\n",
        "            merged.representative_point()\n",
        "        )\n",
        "\n",
        "        if (\n",
        "            point is None\n",
        "            or point.is_empty\n",
        "        ):\n",
        "\n",
        "            return None, None\n",
        "\n",
        "        return (\n",
        "            float(point.y),\n",
        "            float(point.x)\n",
        "        )\n",
        "\n",
        "    except Exception:\n",
        "\n",
        "        return None, None\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# ⭐ NEW — SCENE / AOI COVERAGE CHECK\n",
        "# ==============================================================================\n",
        "\n",
        "def check_scene_aoi_coverage(\n",
        "    scene_image,\n",
        "    aoi_geom\n",
        "):\n",
        "\n",
        "    \"\"\"\n",
        "    Calculate how much of the uploaded AOI is covered\n",
        "    by the selected scene.\n",
        "\n",
        "    Coverage is calculated as:\n",
        "\n",
        "        Area(Scene ∩ AOI)\n",
        "        ------------------ × 100\n",
        "             Area(AOI)\n",
        "\n",
        "    Returns:\n",
        "        coverage_fraction\n",
        "        coverage_percent\n",
        "        aoi_area\n",
        "        overlap_area\n",
        "    \"\"\"\n",
        "\n",
        "    try:\n",
        "\n",
        "        print()\n",
        "        print(\n",
        "            \"🔎 Checking scene coverage of the uploaded AOI...\"\n",
        "        )\n",
        "\n",
        "        # --------------------------------------------------------------\n",
        "        # Scene footprint\n",
        "        # --------------------------------------------------------------\n",
        "\n",
        "        scene_geometry = (\n",
        "            scene_image.geometry()\n",
        "        )\n",
        "\n",
        "        # --------------------------------------------------------------\n",
        "        # AOI area\n",
        "        # --------------------------------------------------------------\n",
        "\n",
        "        aoi_area = (\n",
        "            aoi_geom\n",
        "            .area(\n",
        "                maxError=1\n",
        "            )\n",
        "        )\n",
        "\n",
        "        # --------------------------------------------------------------\n",
        "        # Scene ∩ AOI\n",
        "        # --------------------------------------------------------------\n",
        "\n",
        "        overlap_geometry = (\n",
        "            scene_geometry\n",
        "            .intersection(\n",
        "                aoi_geom,\n",
        "                maxError=1\n",
        "            )\n",
        "        )\n",
        "\n",
        "        overlap_area = (\n",
        "            overlap_geometry\n",
        "            .area(\n",
        "                maxError=1\n",
        "            )\n",
        "        )\n",
        "\n",
        "        # --------------------------------------------------------------\n",
        "        # Coverage fraction\n",
        "        # --------------------------------------------------------------\n",
        "\n",
        "        coverage_fraction = (\n",
        "            ee.Number(\n",
        "                overlap_area\n",
        "            )\n",
        "            .divide(\n",
        "                ee.Number(\n",
        "                    aoi_area\n",
        "                )\n",
        "            )\n",
        "        )\n",
        "\n",
        "        coverage_percent = (\n",
        "            coverage_fraction\n",
        "            .multiply(100)\n",
        "        )\n",
        "\n",
        "        # --------------------------------------------------------------\n",
        "        # Get values\n",
        "        # --------------------------------------------------------------\n",
        "\n",
        "        result = ee.Dictionary({\n",
        "\n",
        "            \"aoi_area_m2\":\n",
        "                aoi_area,\n",
        "\n",
        "            \"overlap_area_m2\":\n",
        "                overlap_area,\n",
        "\n",
        "            \"coverage_fraction\":\n",
        "                coverage_fraction,\n",
        "\n",
        "            \"coverage_percent\":\n",
        "                coverage_percent\n",
        "\n",
        "        }).getInfo()\n",
        "\n",
        "        aoi_area_value = float(\n",
        "            result[\"aoi_area_m2\"]\n",
        "        )\n",
        "\n",
        "        overlap_area_value = float(\n",
        "            result[\"overlap_area_m2\"]\n",
        "        )\n",
        "\n",
        "        coverage_fraction_value = float(\n",
        "            result[\"coverage_fraction\"]\n",
        "        )\n",
        "\n",
        "        coverage_percent_value = float(\n",
        "            result[\"coverage_percent\"]\n",
        "        )\n",
        "\n",
        "        return (\n",
        "            coverage_fraction_value,\n",
        "            coverage_percent_value,\n",
        "            aoi_area_value,\n",
        "            overlap_area_value\n",
        "        )\n",
        "\n",
        "    except Exception as e:\n",
        "\n",
        "        print()\n",
        "        print(\n",
        "            \"⚠️ Could not determine scene/AOI coverage.\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"   {e}\"\n",
        "        )\n",
        "\n",
        "        return (\n",
        "            None,\n",
        "            None,\n",
        "            None,\n",
        "            None\n",
        "        )\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# DISPLAY SCENE COVERAGE WARNING\n",
        "# ==============================================================================\n",
        "\n",
        "def report_scene_aoi_coverage(\n",
        "    scene_image,\n",
        "    aoi_geom\n",
        "):\n",
        "\n",
        "    (\n",
        "        coverage_fraction,\n",
        "        coverage_percent,\n",
        "        aoi_area,\n",
        "        overlap_area\n",
        "    ) = check_scene_aoi_coverage(\n",
        "        scene_image,\n",
        "        aoi_geom\n",
        "    )\n",
        "\n",
        "    if coverage_percent is None:\n",
        "\n",
        "        return False\n",
        "\n",
        "    uncovered_percent = max(\n",
        "        0.0,\n",
        "        100.0 - coverage_percent\n",
        "    )\n",
        "\n",
        "    covered_area_km2 = (\n",
        "        overlap_area / 1e6\n",
        "    )\n",
        "\n",
        "    aoi_area_km2 = (\n",
        "        aoi_area / 1e6\n",
        "    )\n",
        "\n",
        "    uncovered_area_km2 = max(\n",
        "        0.0,\n",
        "        aoi_area_km2 - covered_area_km2\n",
        "    )\n",
        "\n",
        "    print()\n",
        "    print(\n",
        "        \"=\" * 70\n",
        "    )\n",
        "\n",
        "    if (\n",
        "        coverage_percent\n",
        "        >= AOI_COMPLETE_COVERAGE_THRESHOLD\n",
        "    ):\n",
        "\n",
        "        print(\n",
        "            \"✅ COMPLETE AOI COVERAGE\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"=\" * 70\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"   AOI coverage by selected scene: \"\n",
        "            f\"{coverage_percent:.4f}%\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"   AOI area: {aoi_area_km2:.4f} km²\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"   Scene/AOI overlap: \"\n",
        "            f\"{covered_area_km2:.4f} km²\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"   The selected scene covers the complete AOI.\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"=\" * 70\n",
        "        )\n",
        "\n",
        "        return True\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\n",
        "            \"⚠️ WARNING: INCOMPLETE AOI COVERAGE\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"=\" * 70\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"   AOI coverage by selected scene: \"\n",
        "            f\"{coverage_percent:.2f}%\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"   Uncovered portion of AOI: \"\n",
        "            f\"{uncovered_percent:.2f}%\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"   Total AOI area: \"\n",
        "            f\"{aoi_area_km2:.4f} km²\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"   Covered AOI area: \"\n",
        "            f\"{covered_area_km2:.4f} km²\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"   Uncovered AOI area: \"\n",
        "            f\"{uncovered_area_km2:.4f} km²\"\n",
        "        )\n",
        "\n",
        "        print()\n",
        "        print(\n",
        "            \"   ℹ️ The download WILL continue.\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"   ℹ️ Only the portion where the scene overlaps\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"      the AOI will contain valid scene data.\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"   ℹ️ The output will NOT contain invented or\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"      extrapolated data for the uncovered AOI.\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"=\" * 70\n",
        "        )\n",
        "\n",
        "        return False\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# EXACT LOCAL AOI MASK\n",
        "# ==============================================================================\n",
        "\n",
        "def exact_clip_geotiff_to_aoi(\n",
        "    input_path,\n",
        "    output_path,\n",
        "    aoi_gdf\n",
        "):\n",
        "\n",
        "    \"\"\"\n",
        "    Exact local polygon clipping.\n",
        "\n",
        "    The GEE download is first obtained as a raster.\n",
        "    This function then:\n",
        "\n",
        "    1. Reads the uploaded AOI polygon.\n",
        "    2. Reprojects AOI to the GeoTIFF CRS.\n",
        "    3. Masks everything outside the actual polygon.\n",
        "    4. Crops the raster to the AOI extent.\n",
        "    5. Writes the final GeoTIFF.\n",
        "    \"\"\"\n",
        "\n",
        "    import rasterio\n",
        "\n",
        "    from rasterio.mask import mask\n",
        "\n",
        "    with rasterio.open(\n",
        "        input_path\n",
        "    ) as src:\n",
        "\n",
        "        aoi_for_raster = (\n",
        "            aoi_gdf.to_crs(\n",
        "                src.crs\n",
        "            )\n",
        "        )\n",
        "\n",
        "        shapes = [\n",
        "            geom.__geo_interface__\n",
        "            for geom in aoi_for_raster.geometry\n",
        "            if geom is not None\n",
        "            and not geom.is_empty\n",
        "        ]\n",
        "\n",
        "        if not shapes:\n",
        "\n",
        "            raise RuntimeError(\n",
        "                \"❌ No valid AOI geometry available for raster masking.\"\n",
        "            )\n",
        "\n",
        "        # --------------------------------------------------------------\n",
        "        # Explicit NoData value.\n",
        "        # --------------------------------------------------------------\n",
        "\n",
        "        output_nodata = -9999.0\n",
        "\n",
        "        # --------------------------------------------------------------\n",
        "        # Exact polygon mask.\n",
        "        # --------------------------------------------------------------\n",
        "\n",
        "        out_image, out_transform = mask(\n",
        "\n",
        "            src,\n",
        "\n",
        "            shapes,\n",
        "\n",
        "            crop=True,\n",
        "\n",
        "            all_touched=False,\n",
        "\n",
        "            filled=True,\n",
        "\n",
        "            nodata=output_nodata\n",
        "\n",
        "        )\n",
        "\n",
        "        out_image = out_image.astype(\n",
        "            \"float32\",\n",
        "            copy=False\n",
        "        )\n",
        "\n",
        "        out_meta = src.meta.copy()\n",
        "\n",
        "        out_meta.update({\n",
        "\n",
        "            \"height\":\n",
        "                out_image.shape[1],\n",
        "\n",
        "            \"width\":\n",
        "                out_image.shape[2],\n",
        "\n",
        "            \"transform\":\n",
        "                out_transform,\n",
        "\n",
        "            \"driver\":\n",
        "                \"GTiff\",\n",
        "\n",
        "            \"dtype\":\n",
        "                \"float32\",\n",
        "\n",
        "            \"count\":\n",
        "                out_image.shape[0],\n",
        "\n",
        "            \"nodata\":\n",
        "                output_nodata\n",
        "\n",
        "        })\n",
        "\n",
        "        with rasterio.open(\n",
        "\n",
        "            output_path,\n",
        "\n",
        "            \"w\",\n",
        "\n",
        "            **out_meta\n",
        "\n",
        "        ) as dst:\n",
        "\n",
        "            dst.write(\n",
        "                out_image\n",
        "            )\n",
        "\n",
        "            try:\n",
        "\n",
        "                dst.set_band_description(\n",
        "                    1,\n",
        "                    \"AOI clipped\"\n",
        "                )\n",
        "\n",
        "            except Exception:\n",
        "\n",
        "                pass\n",
        "\n",
        "    return output_path\n",
        "\n",
        "\n",
