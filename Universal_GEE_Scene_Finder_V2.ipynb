        "\n",
        "    if not upload_widget.value:\n",
        "\n",
        "        return\n",
        "\n",
        "    with aoi_status_output:\n",
        "\n",
        "        clear_output()\n",
        "\n",
        "        try:\n",
        "\n",
        "            items = (\n",
        "                extract_uploaded_items(\n",
        "                    upload_widget.value\n",
        "                )\n",
        "            )\n",
        "\n",
        "            saved_paths = []\n",
        "\n",
        "            for fname, content in items:\n",
        "\n",
        "                path = os.path.join(\n",
        "                    WORKDIR,\n",
        "                    fname\n",
        "                )\n",
        "\n",
        "                parent = os.path.dirname(\n",
        "                    path\n",
        "                )\n",
        "\n",
        "                if parent:\n",
        "\n",
        "                    os.makedirs(\n",
        "                        parent,\n",
        "                        exist_ok=True\n",
        "                    )\n",
        "\n",
        "                with open(\n",
        "                    path,\n",
        "                    \"wb\"\n",
        "                ) as f:\n",
        "\n",
        "                    f.write(\n",
        "                        content\n",
        "                    )\n",
        "\n",
        "                saved_paths.append(\n",
        "                    path\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"📂 {fname}\"\n",
        "                )\n",
        "\n",
        "            main_path = (\n",
        "                resolve_main_vector_path(\n",
        "                    saved_paths\n",
        "                )\n",
        "            )\n",
        "\n",
        "            if main_path is None:\n",
        "\n",
        "                raise ValueError(\n",
        "                    \"❌ No supported AOI file found.\"\n",
        "                )\n",
        "\n",
        "            lower = main_path.lower()\n",
        "\n",
        "            if lower.endswith(\n",
        "                \".zip\"\n",
        "            ):\n",
        "\n",
        "                actual_path, actual_kind = (\n",
        "                    extract_archive_and_find_vector(\n",
        "                        main_path\n",
        "                    )\n",
        "                )\n",
        "\n",
        "            elif lower.endswith(\n",
        "                \".kmz\"\n",
        "            ):\n",
        "\n",
        "                actual_path, actual_kind = (\n",
        "                    extract_archive_and_find_vector(\n",
        "                        main_path\n",
        "                    )\n",
        "                )\n",
        "\n",
        "            elif lower.endswith(\n",
        "                \".gpkg\"\n",
        "            ):\n",
        "\n",
        "                actual_path = main_path\n",
        "                actual_kind = \"gpkg\"\n",
        "\n",
        "            elif lower.endswith(\n",
        "                (\n",
        "                    \".geojson\",\n",
        "                    \".json\"\n",
        "                )\n",
        "            ):\n",
        "\n",
        "                actual_path = main_path\n",
        "                actual_kind = \"geojson\"\n",
        "\n",
        "            elif lower.endswith(\n",
        "                \".kml\"\n",
        "            ):\n",
        "\n",
        "                actual_path = main_path\n",
        "                actual_kind = \"kml\"\n",
        "\n",
        "            elif lower.endswith(\n",
        "                \".shp\"\n",
        "            ):\n",
        "\n",
        "                actual_path = main_path\n",
        "                actual_kind = \"shp\"\n",
        "\n",
        "            else:\n",
        "\n",
        "                raise ValueError(\n",
        "                    \"❌ Unsupported AOI format.\"\n",
        "                )\n",
        "\n",
        "            current_vector_path = actual_path\n",
        "            current_vector_kind = actual_kind\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                \"📌 Detected AOI format:\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                f\"   {actual_kind.upper()}\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                f\"   {actual_path}\"\n",
        "            )\n",
        "\n",
        "            layers = (\n",
        "                list_layers(\n",
        "                    actual_path\n",
        "                )\n",
        "                if actual_kind == \"gpkg\"\n",
        "                else []\n",
        "            )\n",
        "\n",
        "            if (\n",
        "                actual_kind == \"gpkg\"\n",
        "                and len(layers) > 1\n",
        "            ):\n",
        "\n",
        "                layer_dropdown.options = layers\n",
        "\n",
        "                layer_dropdown.disabled = False\n",
        "\n",
        "                layer_dropdown.value = layers[0]\n",
        "\n",
        "                load_and_report_aoi(\n",
        "\n",
        "                    actual_path,\n",
        "\n",
        "                    actual_kind,\n",
        "\n",
        "                    layers[0]\n",
        "\n",
        "                )\n",
        "\n",
        "            else:\n",
        "\n",
        "                layer_dropdown.options = (\n",
        "\n",
        "                    [layers[0]]\n",
        "\n",
        "                    if layers\n",
        "\n",
        "                    else [\"N/A\"]\n",
        "\n",
        "                )\n",
        "\n",
        "                layer_dropdown.value = (\n",
        "                    layer_dropdown.options[0]\n",
        "                )\n",
        "\n",
        "                layer_dropdown.disabled = True\n",
        "\n",
        "                load_and_report_aoi(\n",
        "\n",
        "                    actual_path,\n",
        "\n",
        "                    actual_kind,\n",
        "\n",
        "                    layers[0]\n",
        "                    if layers\n",
        "                    else None\n",
        "\n",
        "                )\n",
        "\n",
        "            load_bands()\n",
        "\n",
        "        except Exception as e:\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                \"❌ AOI upload failed:\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                str(e)\n",
        "            )\n",
        "\n",
        "\n",
        "upload_widget.observe(\n",
        "    handle_aoi_upload,\n",
        "    names=\"value\"\n",
        ")\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# GPKG LAYER CHANGE\n",
        "# ==============================================================================\n",
        "\n",
        "def handle_layer_change(change):\n",
        "\n",
        "    if change[\"name\"] != \"value\":\n",
        "\n",
        "        return\n",
        "\n",
        "    layer = change[\"new\"]\n",
        "\n",
        "    if (\n",
        "        not current_vector_path\n",
        "        or layer in (None, \"N/A\")\n",
        "    ):\n",
        "\n",
        "        return\n",
        "\n",
        "    with aoi_status_output:\n",
        "\n",
        "        clear_output()\n",
        "\n",
        "        try:\n",
        "\n",
        "            load_and_report_aoi(\n",
        "\n",
        "                current_vector_path,\n",
        "\n",
        "                current_vector_kind,\n",
        "\n",
        "                layer\n",
        "\n",
        "            )\n",
        "\n",
        "        except Exception as e:\n",
        "\n",
        "            print(\n",
        "                \"❌ Could not load layer:\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                str(e)\n",
        "            )\n",
        "\n",
        "\n",
        "layer_dropdown.observe(\n",
        "    handle_layer_change,\n",
        "    names=\"value\"\n",
        ")\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# LOAD BANDS\n",
        "# ==============================================================================\n",
        "\n",
        "def load_bands(*args):\n",
        "\n",
        "    with status_output:\n",
        "\n",
        "        clear_output()\n",
        "\n",
        "        try:\n",
        "\n",
        "            scene_index = scene_dropdown.value\n",
        "\n",
        "            row = df.loc[\n",
        "                scene_index\n",
        "            ]\n",
        "\n",
        "            asset_id = str(\n",
        "                row[\"GEE_Asset_ID\"]\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                \"🛰️ Scene:\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                asset_id\n",
        "            )\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                \"🔎 Loading available bands...\"\n",
        "            )\n",
        "\n",
        "            img, bands = (\n",
        "                get_available_bands(\n",
        "                    asset_id\n",
        "                )\n",
        "            )\n",
        "\n",
        "            band_selection.options = bands\n",
        "\n",
        "            band_selection.value = (\n",
        "                tuple(bands)\n",
        "            )\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                f\"✅ {len(bands)} bands available.\"\n",
        "            )\n",
        "\n",
        "        except Exception as e:\n",
        "\n",
        "            band_selection.options = []\n",
        "\n",
        "            print(\n",
        "                \"❌ Could not load bands:\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                str(e)\n",
        "            )\n",
        "\n",
        "\n",
        "refresh_bands_button.on_click(\n",
        "    load_bands\n",
        ")\n",
        "\n",
        "\n",
        "scene_dropdown.observe(\n",
        "\n",
        "    lambda change:\n",
        "\n",
        "        load_bands()\n",
        "\n",
        "        if change[\"name\"] == \"value\"\n",
        "\n",
        "        else None,\n",
        "\n",
        "    names=\"value\"\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# BAND MODE\n",
        "# ==============================================================================\n",
        "\n",
        "def handle_band_mode(change):\n",
        "\n",
        "    if change[\"name\"] != \"value\":\n",
        "\n",
        "        return\n",
        "\n",
        "    if change[\"new\"] == \"ALL\":\n",
        "\n",
        "        band_selection.value = (\n",
        "            tuple(\n",
        "                band_selection.options\n",
        "            )\n",
        "        )\n",
        "\n",
        "        band_selection.disabled = True\n",
        "\n",
        "    else:\n",
        "\n",
        "        band_selection.disabled = False\n",
        "\n",
        "\n",
        "band_mode.observe(\n",
        "    handle_band_mode,\n",
        "    names=\"value\"\n",
        ")\n",
        "\n",
        "band_selection.disabled = True\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# ⭐ CORRECTED DOWNLOAD FUNCTION\n",
        "# ==============================================================================\n",
        "\n",
        "def download_selected_scene(button):\n",
        "\n",
        "    global uploaded_gdf\n",
        "    global uploaded_ee_aoi\n",
        "\n",
        "    with status_output:\n",
        "\n",
        "        clear_output()\n",
        "\n",
        "        print(\n",
        "            \"=\" * 70\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"🛰️ EXACT AOI GEOTIFF DOWNLOAD\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"=\" * 70\n",
        "        )\n",
        "\n",
        "        # ==============================================================\n",
        "        # AOI CHECK\n",
        "        # ==============================================================\n",
        "\n",
        "        if (\n",
        "            CLIP_TO_SHAPEFILE\n",
        "            and uploaded_ee_aoi is None\n",
        "        ):\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                \"❌ Please upload an AOI first.\"\n",
        "            )\n",
        "\n",
        "            return\n",
        "\n",
        "        # ==============================================================\n",
        "        # SCENE\n",
        "        # ==============================================================\n",
        "\n",
        "        scene_index = scene_dropdown.value\n",
        "\n",
        "        row = df.loc[\n",
        "            scene_index\n",
        "        ]\n",
        "\n",
        "        asset_id = str(\n",
        "            row[\"GEE_Asset_ID\"]\n",
        "        )\n",
        "\n",
        "        print()\n",
        "        print(\n",
        "            \"🛰️ Scene:\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            asset_id\n",
        "        )\n",
        "\n",
        "        # ==============================================================\n",
        "        # LOAD IMAGE\n",
        "        # ==============================================================\n",
        "\n",
        "        try:\n",
        "\n",
        "            img = ee.Image(\n",
        "                asset_id\n",
        "            )\n",
        "\n",
        "            available_bands = (\n",
        "                img.bandNames()\n",
        "                .getInfo()\n",
        "            )\n",
        "\n",
        "        except Exception as e:\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                \"❌ Could not load GEE image:\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                str(e)\n",
        "            )\n",
        "\n",
        "            return\n",
        "\n",
        "        # ==============================================================\n",
        "        # ⭐ NEW — SCENE/AOI COVERAGE CHECK\n",
        "        # ==============================================================\n",
        "\n",
        "        if CLIP_TO_SHAPEFILE:\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                \"📐 Checking whether the selected scene \"\n",
        "                \"covers the complete AOI...\"\n",
        "            )\n",
        "\n",
        "            report_scene_aoi_coverage(\n",
        "\n",
        "                img,\n",
        "\n",
        "                uploaded_ee_aoi\n",
        "\n",
        "            )\n",
        "\n",
        "        # ==============================================================\n",
        "        # BAND SELECTION\n",
        "        # ==============================================================\n",
        "\n",
        "        if band_mode.value == \"ALL\":\n",
        "\n",
        "            selected_bands = (\n",
        "                available_bands\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            selected_bands = list(\n",
        "                band_selection.value\n",
        "            )\n",
        "\n",
        "            if not selected_bands:\n",
        "\n",
        "                print()\n",
        "                print(\n",
        "                    \"❌ No bands selected.\"\n",
        "                )\n",
        "\n",
        "                return\n",
        "\n",
        "        invalid_bands = [\n",
        "\n",
        "            b\n",
        "\n",
        "            for b in selected_bands\n",
        "\n",
        "            if b not in available_bands\n",
        "\n",
        "        ]\n",
        "\n",
        "        if invalid_bands:\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                \"❌ Invalid bands:\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                invalid_bands\n",
        "            )\n",
        "\n",
        "            return\n",
        "\n",
        "        print()\n",
        "        print(\n",
        "            \"📡 Bands:\"\n",
        "        )\n",
        "\n",
        "        for band in selected_bands:\n",
        "\n",
        "            print(\n",
        "                f\"   • {band}\"\n",
        "            )\n",
        "\n",
        "        # ==============================================================\n",
        "        # ⭐ FIX 1 — FORCE ALL BANDS TO FLOAT32\n",
        "        # ==============================================================\n",
        "\n",
        "        img = (\n",
        "\n",
        "            img\n",
        "\n",
        "            .select(\n",
        "                selected_bands\n",
        "            )\n",
        "\n",
        "            .toFloat()\n",
        "\n",
        "        )\n",
        "\n",
        "        print()\n",
        "        print(\n",
        "            \"✅ All selected bands converted to Float32.\"\n",
        "        )\n",
        "\n",
        "        # ==============================================================\n",
        "        # REGION + EXACT AOI CLIP\n",
        "        # ==============================================================\n",
        "\n",
        "        export_region_geom = None\n",
        "\n",
        "        region_coords = None\n",
        "\n",
        "        if CLIP_TO_SHAPEFILE:\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                \"✂️ Applying exact AOI polygon clip...\"\n",
        "            )\n",
        "\n",
        "            # ----------------------------------------------------------\n",
        "            # Query coordinate check\n",
        "            # ----------------------------------------------------------\n",
        "\n",
        "            lat, lon = (\n",
        "                get_query_coordinates(\n",
        "                    row\n",
        "                )\n",
        "            )\n",
        "\n",
        "            if (\n",
        "                lat is not None\n",
        "                and lon is not None\n",
        "            ):\n",
        "\n",
        "                print()\n",
        "                print(\n",
        "                    f\"   Query latitude : {lat:.8f}\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"   Query longitude: {lon:.8f}\"\n",
        "                )\n",
        "\n",
        "                try:\n",
        "\n",
        "                    query_point = ee.Geometry.Point(\n",
        "                        [\n",
        "                            lon,\n",
        "                            lat\n",
        "                        ]\n",
        "                    )\n",
        "\n",
        "                    inside = (\n",
        "                        uploaded_ee_aoi\n",
        "                        .contains(\n",
        "                            query_point\n",
        "                        )\n",
        "                        .getInfo()\n",
        "                    )\n",
        "\n",
        "                except Exception as e:\n",
        "\n",
        "                    print()\n",
        "                    print(\n",
        "                        \"❌ Could not test query coordinate:\"\n",
        "                    )\n",
        "\n",
        "                    print(\n",
        "                        str(e)\n",
        "                    )\n",
        "\n",
        "                    return\n",
        "\n",
        "                if inside:\n",
        "\n",
        "                    print(\n",
        "                        \"   ✅ Query coordinate lies INSIDE AOI.\"\n",
        "                    )\n",
        "\n",
        "                else:\n",
        "\n",
        "                    print()\n",
        "                    print(\n",
        "                        \"⚠️ WARNING: Query coordinate lies OUTSIDE AOI.\"\n",
        "                    )\n",
        "\n",
        "                    (\n",
        "                        suggested_lat,\n",
        "                        suggested_lon\n",
        "                    ) = (\n",
        "                        get_suggested_inside_coordinate()\n",
        "                    )\n",
        "\n",
        "                    if (\n",
        "                        suggested_lat is not None\n",
        "                        and suggested_lon is not None\n",
        "                    ):\n",
        "\n",
        "                        print()\n",
        "                        print(\n",
        "                            \"💡 Suggested coordinate inside AOI:\"\n",
        "                        )\n",
        "\n",
        "                        print(\n",
        "                            f\"   Latitude : {suggested_lat:.8f}\"\n",
        "                        )\n",
        "\n",
        "                        print(\n",
        "                            f\"   Longitude: {suggested_lon:.8f}\"\n",
        "                        )\n",
        "\n",
        "                    if REQUIRE_POINT_INSIDE_AOI:\n",
        "\n",
        "                        print()\n",
        "                        print(\n",
        "                            \"🚫 DOWNLOAD BLOCKED.\"\n",
        "                        )\n",
        "\n",
        "                        return\n",
        "\n",
        "            # ----------------------------------------------------------\n",
        "            # ACTUAL POLYGON CLIP\n",
        "            # ----------------------------------------------------------\n",
        "\n",
        "            img = img.clip(\n",
        "                uploaded_ee_aoi\n",
        "            )\n",
        "\n",
        "            # ----------------------------------------------------------\n",
        "            # Export region is ONLY used to define the download window.\n",
        "            # Exact polygon mask is already applied above.\n",
        "            # ----------------------------------------------------------\n",
        "\n",
        "            export_region_geom = (\n",
        "                uploaded_ee_aoi\n",
        "            )\n",
        "\n",
        "            region_coords = (\n",
        "\n",
        "                uploaded_ee_aoi\n",
        "\n",
        "                .bounds(\n",
        "                    maxError=1\n",
        "                )\n",
        "\n",
        "                .getInfo()[\"coordinates\"]\n",
        "\n",
        "            )\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                \"   ✅ Image masked using the ACTUAL AOI polygon.\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                \"   ℹ️ Bounding box is used only as the download window.\"\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            export_region_geom = (\n",
        "                img.geometry()\n",
        "            )\n",
        "\n",
        "            region_coords = (\n",
        "\n",
        "                img.geometry()\n",
        "\n",
        "                .bounds()\n",
        "\n",
        "                .getInfo()[\"coordinates\"]\n",
        "\n",
        "            )\n",
        "\n",
        "        # ==============================================================\n",
        "        # FILENAME\n",
        "        # ==============================================================\n",
        "\n",
        "        filename = safe_filename(\n",
        "            OUTPUT_FILENAME\n",
        "        )\n",
        "\n",
        "        raw_download_path = os.path.join(\n",
        "\n",
        "            OUTPUT_DIRECTORY,\n",
        "\n",
        "            filename + \"_RAW.tif\"\n",
        "\n",
        "        )\n",
        "\n",
        "        final_output_path = os.path.join(\n",
        "\n",
        "            OUTPUT_DIRECTORY,\n",
        "\n",
        "            filename + \".tif\"\n",
        "\n",
        "        )\n",
        "\n",
        "        print()\n",
        "        print(\n",
        "            \"Creating GeoTIFF...\"\n",
        "        )\n",
        "\n",
        "        # ==============================================================\n",
        "        # DIRECT GEOTIFF\n",
        "        # ==============================================================\n",
        "\n",
        "        try:\n",
        "\n",
        "            download_params = {\n",
        "\n",
        "                \"name\":\n",
        "                    filename,\n",
        "\n",
        "                \"region\":\n",
        "                    region_coords,\n",
        "\n",
        "                \"scale\":\n",
        "                    EXPORT_SCALE_METERS,\n",
        "\n",
        "                \"crs\":\n",
        "                    \"EPSG:4326\",\n",
        "\n",
        "                \"format\":\n",
        "                    \"GEO_TIFF\",\n",
        "\n",
        "                \"filePerBand\":\n",
        "                    False,\n",
        "\n",
        "                \"maxPixels\":\n",
        "                    1e13\n",
        "\n",
        "            }\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                \"⬇️ Downloading GEE raster...\"\n",
        "            )\n",
        "\n",
        "            download_url = (\n",
        "                img.getDownloadURL(\n",
        "                    download_params\n",
        "                )\n",
        "            )\n",
        "\n",
        "            response = requests.get(\n",
        "\n",
        "                download_url,\n",
        "\n",
        "                stream=True,\n",
        "\n",
        "                timeout=600\n",
        "\n",
        "            )\n",
        "\n",
        "            response.raise_for_status()\n",
        "\n",
        "            with open(\n",
        "\n",
        "                raw_download_path,\n",
        "\n",
        "                \"wb\"\n",
        "\n",
        "            ) as f:\n",
        "\n",
        "                for chunk in response.iter_content(\n",
        "\n",
        "                    chunk_size=1024 * 1024\n",
        "\n",
        "                ):\n",
        "\n",
        "                    if chunk:\n",
        "\n",
        "                        f.write(\n",
        "                            chunk\n",
        "                        )\n",
        "\n",
        "            if not os.path.exists(\n",
        "                raw_download_path\n",
        "            ):\n",
        "\n",
        "                raise RuntimeError(\n",
        "                    \"Raw GeoTIFF was not created.\"\n",
        "                )\n",
        "\n",
        "            if os.path.getsize(\n",
        "                raw_download_path\n",
        "            ) == 0:\n",
        "\n",
        "                raise RuntimeError(\n",
        "                    \"Downloaded GeoTIFF is empty.\"\n",
        "                )\n",
        "\n",
        "            # ==========================================================\n",
        "            # ⭐ FIX 2 — EXACT LOCAL POLYGON MASK\n",
        "            # ==========================================================\n",
        "\n",
        "            if CLIP_TO_SHAPEFILE:\n",
        "\n",
        "                print()\n",
        "                print(\n",
        "                    \"✂️ Applying EXACT polygon mask to downloaded GeoTIFF...\"\n",
        "                )\n",
        "\n",
        "                exact_clip_geotiff_to_aoi(\n",
        "\n",
        "                    raw_download_path,\n",
        "\n",
        "                    final_output_path,\n",
        "\n",
        "                    uploaded_gdf\n",
        "\n",
        "                )\n",
        "\n",
        "                try:\n",
        "\n",
        "                    os.remove(\n",
        "                        raw_download_path\n",
        "                    )\n",
        "\n",
        "                except Exception:\n",
        "\n",
        "                    pass\n",
        "\n",
        "            else:\n",
        "\n",
        "                os.rename(\n",
        "\n",
        "                    raw_download_path,\n",
        "\n",
        "                    final_output_path\n",
        "\n",
        "                )\n",
        "\n",
        "            # ==========================================================\n",
        "            # VALIDATE FINAL TIFF\n",
        "            # ==============================================================\n",
        "\n",
        "            import rasterio\n",
        "\n",
        "            with rasterio.open(\n",
        "\n",
        "                final_output_path\n",
        "\n",
        "            ) as src:\n",
        "\n",
        "                print()\n",
        "                print(\n",
        "                    \"🔍 Final GeoTIFF validation:\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"   Driver : {src.driver}\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"   Width  : {src.width}\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"   Height : {src.height}\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"   Bands  : {src.count}\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"   CRS    : {src.crs}\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"   Dtype  : {src.dtypes}\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"   NoData : {src.nodata}\"\n",
        "                )\n",
        "\n",
        "                if (\n",
        "\n",
        "                    src.width <= 0\n",
        "\n",
        "                    or\n",
        "\n",
        "                    src.height <= 0\n",
        "\n",
        "                ):\n",
        "\n",
        "                    raise RuntimeError(\n",
        "                        \"Invalid GeoTIFF dimensions.\"\n",
        "                    )\n",
        "\n",
        "            file_size = os.path.getsize(\n",
        "                final_output_path\n",
        "            )\n",
        "\n",
        "            file_size_mb = (\n",
        "\n",
        "                file_size\n",
        "\n",
        "                /\n",
        "\n",
        "                (1024 * 1024)\n",
        "\n",
        "            )\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                \"=\" * 70\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                \"✅ EXACT AOI GEOTIFF DOWNLOAD COMPLETED\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                \"=\" * 70\n",
        "            )\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                f\"📁 File: {final_output_path}\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                f\"📦 Size: {file_size_mb:.2f} MB\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                f\"📡 Bands: {len(selected_bands)}\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                f\"📏 Scale: {EXPORT_SCALE_METERS} m\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                \"🗺️ CRS: EPSG:4326\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                \"✂️ Clip: EXACT AOI POLYGON\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                \"🔢 Data type: Float32\"\n",
        "            )\n",
        "\n",
        "            # ==========================================================\n",
        "            # BROWSER DOWNLOAD\n",
        "            # ==========================================================\n",
        "\n",
        "            if AUTO_DOWNLOAD:\n",
        "\n",
        "                print()\n",
        "                print(\n",
        "                    \"⬇️ Sending final AOI-clipped GeoTIFF to browser...\"\n",
        "                )\n",
        "\n",
        "                try:\n",
        "\n",
        "                    from google.colab import files\n",
        "\n",
        "                    files.download(\n",
        "                        final_output_path\n",
        "                    )\n",
        "\n",
        "                    print(\n",
        "                        \"🎉 Download initiated.\"\n",
        "                    )\n",
        "\n",
        "                except Exception as e:\n",
        "\n",
        "                    print()\n",
        "                    print(\n",
        "                        \"ℹ️ Automatic browser download failed:\"\n",
        "                    )\n",
        "\n",
        "                    print(\n",
        "                        str(e)\n",
        "                    )\n",
        "\n",
        "                    print()\n",
        "                    print(\n",
        "                        \"The GeoTIFF remains at:\"\n",
        "                    )\n",
        "\n",
        "                    print(\n",
        "                        final_output_path\n",
        "                    )\n",
        "\n",
        "        # ==============================================================\n",
        "        # DIRECT DOWNLOAD FAILED → DRIVE FALLBACK\n",
        "        # ==============================================================\n",
        "\n",
        "        except Exception as direct_error:\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                \"⚠️ Direct GeoTIFF download failed:\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                str(direct_error)\n",
        "            )\n",
        "\n",
        "            if os.path.exists(\n",
        "                raw_download_path\n",
        "            ):\n",
        "\n",
        "                try:\n",
        "\n",
        "                    os.remove(\n",
        "                        raw_download_path\n",
        "                    )\n",
        "\n",
        "                except Exception:\n",
        "\n",
        "                    pass\n",
        "\n",
        "            if not ENABLE_DRIVE_FALLBACK:\n",
        "\n",
        "                print()\n",
        "                print(\n",
        "                    \"🚫 Drive fallback is disabled.\"\n",
        "                )\n",
        "\n",
        "                return\n",
        "\n",
        "            print()\n",
        "            print(\n",
        "                \"🔄 Starting GeoTIFF export to Google Drive...\"\n",
        "            )\n",
        "\n",
        "            safe_name = safe_filename(\n",
        "                filename\n",
        "            )\n",
        "\n",
        "            try:\n",
        "\n",
        "                task = (\n",
        "                    ee.batch.Export.image.toDrive(\n",
        "\n",
        "                        image=img,\n",
        "\n",
        "                        description=(\n",
        "                            safe_name[:100]\n",
        "                        ),\n",
        "\n",
        "                        folder=(\n",
        "                            DRIVE_EXPORT_FOLDER\n",
        "                        ),\n",
        "\n",
        "                        fileNamePrefix=(\n",
        "                            safe_name\n",
        "                        ),\n",
        "\n",
        "                        region=(\n",
        "                            export_region_geom\n",
        "                        ),\n",
        "\n",
        "                        scale=(\n",
        "                            EXPORT_SCALE_METERS\n",
        "                        ),\n",
        "\n",
        "                        crs=\"EPSG:4326\",\n",
        "\n",
        "                        fileFormat=\"GeoTIFF\",\n",
        "\n",
        "                        maxPixels=1e13\n",
        "\n",
        "                    )\n",
        "                )\n",
        "\n",
        "                task.start()\n",
        "\n",
        "                print()\n",
        "                print(\n",
        "                    \"🚀 GeoTIFF Drive export task started.\"\n",
        "                )\n",
        "\n",
        "                print()\n",
        "                print(\n",
        "                    f\"   Task ID: {task.id}\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    f\"   Drive folder: My Drive/{DRIVE_EXPORT_FOLDER}/\"\n",
        "                )\n",
        "\n",
        "                print()\n",
        "                print(\n",
        "                    \"   The Drive export is Float32 and \"\n",
        "                    \"pixels outside the AOI polygon are masked.\"\n",
        "                )\n",
        "\n",
        "            except Exception as drive_error:\n",
        "\n",
        "                print()\n",
        "                print(\n",
        "                    \"❌ Could not start Drive GeoTIFF export:\"\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    str(drive_error)\n",
        "                )\n",
        "\n",
        "\n",
